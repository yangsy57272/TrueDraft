{
  "name": "truedraft",
  "version": "0.1.8",
  "description": "Ethical, bilingual college-essay feedback for students.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "retention:run": "tsx --conditions=react-server scripts/retention.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cds:import": "tsx --conditions=react-server scripts/import-cds.ts",
    "scorecard:build": "tsx scripts/build-scorecard-extract.ts",
    "scorecard:import": "tsx --conditions=react-server scripts/import-scorecard.ts",
    "supplements:import": "tsx --conditions=react-server scripts/import-supplements.ts",
    "eval:ai": "tsx --conditions=react-server scripts/ai-eval.ts",
    "desktop:build": "node scripts/desktop/pack.mjs",
    "db:import-postgres": "tsx --conditions=react-server scripts/import-postgres.ts"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "better-auth": "^1.7.14",
    "better-sqlite3": "13.0.3",
    "diff": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.3",
    "nodemailer": "^10.2.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "pg": "8.23.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^4.1.12"
  },
  "private": true
}
