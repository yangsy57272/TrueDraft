# ---------------------------------------------------------------------------
# TrueDraft configuration. Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public base URL of the app (used for sign-in links and origin checks).
APP_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# 32+ random bytes, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# PostgreSQL
DATABASE_URL=postgres://truedraft:truedraft@localhost:5432/truedraft
# Set to "require" for managed databases that need TLS.
DATABASE_SSL=
DATABASE_POOL_MAX=10

# Application-level encryption for drafts, versions, notes, and feedback.
# Comma-separated keyId:base64Key pairs; the FIRST key encrypts, all keys decrypt (rotation).
# Generate a key: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
ENCRYPTION_KEYS=k1:REPLACE_WITH_BASE64_32_BYTE_KEY

# ---------------------------------------------------------------------------
# AI provider (server-side only — keys never reach the browser)
#   anthropic          Claude via the official Anthropic SDK (recommended)
#   openai-compatible  Any OpenAI-compatible Chat Completions endpoint with JSON-schema output
#   mock               Development only: placeholder output, clearly labelled, no AI
#   (empty)            AI feedback disabled; students can still write and save
# ---------------------------------------------------------------------------
AI_PROVIDER=
AI_MODEL=claude-opus-5-5
# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# Claude effort level: low | medium | high (current Claude models do not accept temperature)
AI_EFFORT=medium
# OpenAI-compatible
AI_BASE_URL=
AI_API_KEY=
# Creativity for providers that support it (low-to-moderate recommended)
AI_TEMPERATURE=0.3
# Limits
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=16000
AI_REQUESTS_PER_HOUR=20
AI_REQUESTS_PER_DAY=60
MAX_DRAFT_CHARS=20000
WRITES_PER_MINUTE=120
# Mock provider delay (development/tests only)
MOCK_AI_DELAY_MS=400

# ---------------------------------------------------------------------------
# Privacy facts shown to students. Only state what your provider account and
# contract actually support.
# ---------------------------------------------------------------------------
# Name shown in the consent notice, e.g. "Anthropic (Claude API)"
AI_PROVIDER_DISPLAY_NAME=
# Set to true ONLY if your provider agreement/account settings confirm API data is not used for training.
AI_PROVIDER_NO_TRAINING_CONFIRMED=false
# Describe provider-side retention as stated in your agreement, e.g. "Up to 30 days for abuse monitoring"
AI_PROVIDER_RETENTION_NOTE=
STORAGE_REGION=
PRIVACY_LAST_UPDATED=2026-10-27
# Bump when the privacy/consent text changes; students will be asked to consent again.
PRIVACY_POLICY_VERSION=2026-10-27
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_OPERATOR_NAME=

# ---------------------------------------------------------------------------
# Email (sign-in links)
#   smtp     production (requires SMTP_URL + EMAIL_FROM)
#   console  development: link printed to the server console
#   file     automated tests: link written to .dev-mailbox/
# ---------------------------------------------------------------------------
EMAIL_TRANSPORT=console
SMTP_URL=
EMAIL_FROM=

# Comma-separated admin emails (resource management + aggregate metrics only)
ADMIN_EMAILS=
# Emails allowed to read "restricted" licensed resources
AUTHORIZED_RESOURCE_EMAILS=
# Secret for POST /api/cron/retention (32+ chars)
CRON_SECRET=
# LOG_LEVEL=silent disables application logs (tests)
LOG_LEVEL=
